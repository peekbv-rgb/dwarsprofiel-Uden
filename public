<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kas Sensoren — Dwarsprofiel</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, sans-serif; background: #f0f2f5; color: #333; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 24px 16px; }
h1 { font-size: 22px; font-weight: 700; margin-bottom: 4px; text-align: center; }
.subtitle { font-size: 13px; color: #777; margin-bottom: 24px; text-align: center; }
.card { background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); width: 100%; max-width: 960px; }
.status { font-size: 12px; color: #aaa; text-align: right; margin-bottom: 12px; }
.controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
.tabs { display: flex; gap: 6px; }
.tab { padding: 6px 18px; border: 1px solid #ccc; border-radius: 6px; background: transparent; color: #666; cursor: pointer; font-size: 13px; }
.tab.on { background: #2d7d46; color: #fff; border-color: #2d7d46; font-weight: 500; }
.nav { display: flex; align-items: center; gap: 8px; margin-left: auto; }
.navbtn { width: 32px; height: 32px; border: 1px solid #ccc; border-radius: 6px; background: transparent; cursor: pointer; font-size: 20px; display: flex; align-items: center; justify-content: center; }
.navbtn:hover:not(:disabled) { background: #f0f0f0; }
.navbtn:disabled { opacity: 0.3; cursor: default; }
.daytitle { font-size: 16px; font-weight: 600; min-width: 130px; text-align: center; }
.legend-wrap { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 12px; }
.kas-block { display: flex; flex-direction: column; gap: 5px; }
.kas-title { font-size: 11px; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }
.li { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #555; }
.sw { width: 22px; height: 3px; display: inline-block; border-radius: 2px; }
.chart-wrap { position: relative; width: 100%; height: 340px; }
.dots { text-align: center; font-size: 12px; color: #bbb; margin-top: 10px; letter-spacing: 3px; }
.loading { text-align: center; padding: 60px; color: #888; font-size: 14px; }
.error { text-align: center; padding: 40px; color: #c0392b; font-size: 14px; background: #fdf0f0; border-radius: 8px; }
.refresh-btn { padding: 5px 12px; border: 1px solid #ccc; border-radius: 6px; background: transparent; color: #555; cursor: pointer; font-size: 12px; margin-left: 8px; }
.refresh-btn:hover { background: #f5f5f5; }
@media (max-width: 600px) {
  .nav { margin-left: 0; width: 100%; justify-content: center; }
  .controls { flex-direction: column; align-items: flex-start; }
}
</style>
</head>
<body>

<h1>Kas Sensoren — Dwarsprofiel</h1>
<p class="subtitle">Temperatuur &amp; luchtvochtigheid per kas en hoogte</p>

<div class="card">
  <div class="status" id="status">Laden...</div>
  <div id="app"><div class="loading">⏳ Data ophalen...</div></div>
</div>

<script>
// Sensor config: id, label, kas, height, color, dash
const SENSORS = [
  { id: 'VDB45', label: 'VDB45 — 29 cm',  kas: 'Kas 3', color: '#1D9E75', dash: [] },
  { id: 'VDB39', label: 'VDB39 — 128 cm', kas: 'Kas 3', color: '#0a5c3a', dash: [6,3] },
  { id: 'VDB37', label: 'VDB37 — 29 cm',  kas: 'Kas 4', color: '#378ADD', dash: [] },
  { id: 'VDB36', label: 'VDB36 — 128 cm', kas: 'Kas 4', color: '#1a4f8a', dash: [6,3] },
  { id: 'VDB14', label: 'VDB14 — 184 cm', kas: 'Kas 4', color: '#7B52CC', dash: [3,3] },
];

let DATA = null, DAYS = [], dayIdx = 0, mode = 'temp', chart = null;

function fmtDay(d) {
  const p = d.split('-');
  const mn = ['jan','feb','mrt','apr','mei','jun','jul','aug','sep','okt','nov','dec'][+p[1]-1];
  return p[2] + ' ' + mn + ' ' + p[0];
}

function mkLabel(h) {
  const hr = Math.floor(h), mn = Math.round((h - hr) * 60);
  return hr.toString().padStart(2,'0') + ':' + mn.toString().padStart(2,'0');
}

function mkDatasets(day, m) {
  return SENSORS.map(s => {
    const d = DATA[day] && DATA[day][s.id];
    if (!d || !d.hrs.length) return { label: s.label, data: [], borderColor: s.color, borderWidth: 1.5, pointRadius: 0, tension: 0 };
    return {
      label: s.label,
      data: d.hrs.map((h, j) => ({ x: h, y: d[m][j] })),
      borderColor: s.color,
      borderDash: s.dash,
      borderWidth: 2,
      pointRadius: 0,
      tension: 0.2,
      spanGaps: false
    };
  });
}

function render() {
  const day = DAYS[dayIdx];
  document.getElementById('dtitle').textContent = fmtDay(day);
  document.getElementById('prev').disabled = dayIdx === 0;
  document.getElementById('next').disabled = dayIdx === DAYS.length - 1;
  document.getElementById('dots').textContent = DAYS.map((_, i) => i === dayIdx ? '●' : '·').join(' ');
  if (chart) {
    chart.data.datasets = mkDatasets(day, mode);
    chart.options.scales.y.title.text = mode === 'temp' ? 'Temperatuur (°C)' : 'Luchtvochtigheid (%)';
    chart.update('none');
  }
}

function go(d) { dayIdx = Math.max(0, Math.min(DAYS.length - 1, dayIdx + d)); render(); }
function setMode(m, btn) {
  mode = m;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('on'));
  btn.classList.add('on');
  render();
}

function buildLegend() {
  const kassen = [...new Set(SENSORS.map(s => s.kas))];
  return kassen.map(kas => `
    <div class="kas-block">
      <div class="kas-title">${kas}</div>
      ${SENSORS.filter(s => s.kas === kas).map(s => `
        <span class="li">
          <span class="sw" style="background:${s.color}"></span>${s.label}
        </span>`).join('')}
    </div>`).join('');
}

function buildUI() {
  document.getElementById('app').innerHTML = `
    <div class="controls">
      <div class="tabs">
        <button class="tab on" onclick="setMode('temp',this)">Temperatuur (°C)</button>
        <button class="tab" onclick="setMode('hum',this)">Luchtvochtigheid (%)</button>
      </div>
      <div class="nav">
        <button class="navbtn" id="prev" onclick="go(-1)">&#8249;</button>
        <span class="daytitle" id="dtitle"></span>
        <button class="navbtn" id="next" onclick="go(1)">&#8250;</button>
      </div>
    </div>
    <div class="legend-wrap">${buildLegend()}</div>
    <div class="chart-wrap"><canvas id="c"></canvas></div>
    <div class="dots" id="dots"></div>
  `;

  chart = new Chart(document.getElementById('c'), {
    type: 'line',
    data: { datasets: mkDatasets(DAYS[dayIdx], 'temp') },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            title: items => '🕐 ' + mkLabel(items[0].parsed.x),
            label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y.toFixed(1) + (mode === 'temp' ? ' °C' : ' %')
          }
        }
      },
      scales: {
        x: {
          type: 'linear', min: 0, max: 24,
          ticks: { stepSize: 2, callback: v => v + 'u', color: '#888' },
          grid: { color: 'rgba(0,0,0,0.06)' },
          title: { display: true, text: 'Tijd van de dag', color: '#888', font: { size: 11 } }
        },
        y: {
          ticks: { color: '#888' },
          grid: { color: 'rgba(0,0,0,0.06)' },
          title: { display: true, text: 'Temperatuur (°C)', color: '#888', font: { size: 12 } }
        }
      }
    }
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft') go(-1);
    if (e.key === 'ArrowRight') go(1);
  });

  render();
}

async function loadData() {
  try {
    const res = await fetch('/api/data');
    const json = await res.json();
    if (!json.ok) throw new Error(json.error);

    DATA = json.data;
    DAYS = Object.keys(DATA).sort();
    dayIdx = Math.max(0, DAYS.length - 2);

    const fetched = new Date(json.fetched);
    document.getElementById('status').innerHTML =
      `Laatste update: ${fetched.toLocaleString('nl-NL')} &nbsp;
       <button class="refresh-btn" onclick="loadData()">↻ Vernieuwen</button>`;

    buildUI();
  } catch (err) {
    document.getElementById('app').innerHTML =
      `<div class="error">❌ ${err.message}<br><br>
       <button class="refresh-btn" onclick="loadData()" style="font-size:14px;padding:8px 16px">Opnieuw proberen</button></div>`;
    document.getElementById('status').textContent = 'Laden mislukt';
  }
}

loadData();
</script>
</body>
</html>
